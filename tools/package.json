{
  "name": "ashry-gaming-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Build tooling for Ashry Gaming: the site, the local preview, the CSS, the icons and the content checks.",
  "scripts": {
    "build:css": "tailwindcss -i input.css -o .out.css --minify && node wrap-css.mjs",
    "build:preview": "node build-preview.mjs",
    "build:site": "node build-site.mjs",
    "check:content": "node validate-content.js",
    "build": "npm run build:css && npm run build:preview",
    "watch:css": "tailwindcss -i input.css -o .out.css --watch",
    "check:i18n": "node check-i18n.js",
    "check": "npm run check:content && npm run check:i18n",
    "check:live": "node check-live.mjs",
    "build:icons": "node make-icons.mjs",
    "export:trivia": "node export-trivia-bank.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "tailwindcss": "3.4.17"
  }
}
