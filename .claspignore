# Everything here is local build tooling / scratch output. Apps Script must only
# receive the .html templates, Code.js and appsscript.json — clasp pushes .js and
# .json files as project files, so tools/ has to stay out.
**/node_modules/**
tools/**
# The home-screen wrapper is a static site for GitHub Pages, not Apps Script.
docs/**
.preview/**
.git/**
**/*.md
**/package.json
**/package-lock.json
